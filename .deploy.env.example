# .deploy.env — Configuració de connexió al servidor de producció
# Copia aquest fitxer a .deploy.env i omple els valors.
# IMPORTANT: .deploy.env està al .gitignore — mai es commitarà.

# ── Opció A: Alias SSH (recomanat) ────────────────────────────────────────────
# Configura ~/.ssh/config amb un bloc Host i posa aquí el nom:
#
#   Host cryptdesk-prod
#     HostName <IP_DEL_SERVIDOR>
#     User opc
#     IdentityFile ~/.ssh/oracle_key.pem
#     ServerAliveInterval 60
#
SSH_ALIAS=cryptdesk-prod

# ── Opció B: Connexió directa ─────────────────────────────────────────────────
# Omple si no uses SSH_ALIAS (SSH_ALIAS té prioritat si els dos estan definits)
#
# PROD_HOST=<IP_DEL_SERVIDOR>
# PROD_USER=opc
# PROD_KEY=~/.ssh/oracle_key.pem

# ── Directori de l'app al servidor ───────────────────────────────────────────
PROD_DIR=/home/opc/crypto_dashboard
